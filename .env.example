# ============================================================
# Agent Runtime Defense — Environment Configuration Template
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_API_KEY=your-search-key-here
AZURE_AI_SEARCH_INDEX_NAME=agent-runtime-defense

# PostgreSQL / pgvector
DATABASE_URL=postgresql://ard_user:ard_password@localhost:5432/agent_runtime_defense
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-ns.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key
AZURE_SERVICE_BUS_QUEUE_NAME=agent-events

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=RS256
JWT_EXPIRY_SECONDS=3600

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false

# Redis (rate limiting)
REDIS_URL=redis://localhost:6379/0

# Anomaly Detection
ANOMALY_DETECTION_CONTAMINATION=0.1
ANOMALY_DETECTION_THRESHOLD=0.7
ISOLATION_APPROVAL_REQUIRED=true

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-runtime-defense

# Sentinel / Azure Monitor
AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/
