{
  "title": "Agent Runtime Defense - Platform Overview",
  "uid": "ard-platform-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Anomaly Score Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(behavior_anomaly_score_bucket[5m]))",
          "legendFormat": "p95 anomaly score"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(agent_runtime_active_sessions)",
          "legendFormat": "Active Sessions"
        }
      ]
    },
    {
      "id": 3,
      "title": "Response Actions Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "rate(response_actions_total[5m])",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "API Request Latency P99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "T2 Approval Pending Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(approval_requests_pending)",
          "legendFormat": "Pending Approvals"
        }
      ]
    }
  ]
}
