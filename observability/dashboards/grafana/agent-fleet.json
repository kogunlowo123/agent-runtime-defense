{
  "title": "Agent Runtime Defense - Agent Fleet",
  "uid": "ard-agent-fleet",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Agents by Tier",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (tier) (agent_runtime_active_sessions)",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Token Consumption Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "rate(agent_tokens_consumed_total[5m])",
          "legendFormat": "{{agent_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Anomalous Agents",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "topk(20, agent_anomaly_score > 0.7)",
          "legendFormat": "{{principal_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "MITRE Tactic Distribution",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum by (tactic) (mitre_tactic_detections_total)",
          "legendFormat": "{{tactic}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Isolations Last 24h",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "increase(response_actions_total{action=\"isolate\"}[24h])",
          "legendFormat": "Isolations"
        }
      ]
    }
  ]
}
